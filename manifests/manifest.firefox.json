{
  "manifest_version": 3,
  "name": "Amazon Best Price Europe",
  "description": "Compare and find the best price in Amazon EU markets.",
  "version": "2.0.0",
  "icons": {
    "128": "icon128.png",
    "48": "icon48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "IronCore864@amazon-eu-price-compare",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_icon": "icon128.png",
    "default_popup": "popup.html",
    "default_title": "Amazon Best Price Europe"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://www.amazon.co.uk/*",
    "*://www.amazon.de/*",
    "*://www.amazon.fr/*",
    "*://www.amazon.it/*",
    "*://www.amazon.es/*",
    "*://www.amazon.nl/*",
    "*://www.amazon.se/*",
    "*://www.amazon.pl/*",
    "*://www.amazon.com.be/*",
    "*://www.amazon.ie/*",
    "https://ajax.googleapis.com/"
  ],
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.amazon.co.uk/*",
        "*://www.amazon.de/*",
        "*://www.amazon.fr/*",
        "*://www.amazon.it/*",
        "*://www.amazon.es/*",
        "*://www.amazon.nl/*",
        "*://www.amazon.se/*",
        "*://www.amazon.pl/*",
        "*://www.amazon.com.be/*",
        "*://www.amazon.ie/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}

{
  "name": "amazon-eu-price-compare",
  "version": "2.0.0",
  "description": "This extension compares price from amazon de, it, es, fr, nl, be and uk",
  "main": "content.js",
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "node scripts/build.js chrome",
    "build:firefox": "node scripts/build.js firefox",
    "lint:firefox": "npx --yes web-ext lint --source-dir dist/firefox",
    "zip": "npm run zip:chrome && npm run zip:firefox",
    "zip:chrome": "cd dist/chrome && zip -qr ../amazon-eu-price-compare-chrome.zip .",
    "zip:firefox": "cd dist/firefox && zip -qr ../amazon-eu-price-compare-firefox.zip ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IronCore864/amazon-eu-price-compare.git"
  },
  "author": "Tiexin Guo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IronCore864/amazon-eu-price-compare/issues"
  },
  "homepage": "https://github.com/IronCore864/amazon-eu-price-compare#readme",
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "babel-loader": "^10.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^3.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  }
}
